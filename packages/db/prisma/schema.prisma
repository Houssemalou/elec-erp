// ============================================================================
// Schéma Prisma — Magasin de produits électriques (Tunisie)
// Monorepo : packages/db
// Conventions :
//   - Monnaie : DT, Decimal(12,3) (millimes)
//   - Quantités : Decimal(14,3)
//   - Code (noms de modèles/champs) en anglais, interface d'UI en français.
//   - Tous les documents monétaires stockent un découpage TVA par taux
//     (vatBreakdown: Json) + totalTVA agrégé.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  VENDEUR
  CLIENT
}

enum StockMovementType {
  PURCHASE_RECEIPT // Réception fournisseur
  SALE // Vente (POS / commande en ligne confirmée)
  RETURN // Retour produit (avoir)
  ADJUSTMENT // Ajustement manuel (motif obligatoire)
  TRANSFER_OUT // Transfert sortant de dépôt
  TRANSFER_IN // Transfert entrant de dépôt
  RESERVATION // Réservation stock (commande en ligne)
  RELEASE // Libération de réservation
  INVENTORY // Écart d'inventaire
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CustomerType {
  PARTICULIER
  PROFESSIONNEL
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REFUSED
  CONVERTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  VALIDATED
  PAID
  PARTIALLY_PAID
  CANCELLED
  CREDITED
}

enum CreditNoteStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
  EDAHABIA
  ONLINE
}

enum OnlinePaymentMethod {
  COD // Paiement à la livraison
  CARD
  EDAHABIA
  BANK_TRANSFER
}

enum OnlineDeliveryMethod {
  DELIVERY // Livraison à domicile
  PICKUP // Retrait en magasin
}

enum OnlinePaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OnlineOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum InvoiceSource {
  MANUAL // Créée manuellement via l'ERP
  POS    // Vente en caisse (point de vente)
}

enum NotificationType {
  NEW_ORDER
  NEW_QUOTE_REQUEST
  STOCK_ALERT
  PAYMENT_RECEIVED
  QUOTE_ACCEPTED
  STOCK_RECEIVED
  SYSTEM
}

// ---------------------------------------------------------------------------
// Utilisateurs, rôles, authentification
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(VENDEUR)
  phone        String?
  isActive     Boolean   @default(true)
  emailVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]  @relation("PurchaseOrderCreator")
  quotes         Quote[]          @relation("QuoteCreator")
  invoices       Invoice[]        @relation("InvoiceCreator")
  payments       Payment[]
  notifications  Notification[]
  customer       Customer?
  creditNotes    CreditNote[]     @relation("CreditNoteCreator")

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// TVA (taux configurables : 19% / 13% / 7%)
// ---------------------------------------------------------------------------

model TaxRate {
  id        String  @id @default(cuid())
  rate      Decimal @db.Decimal(4, 2) // ex: 19.00
  label     String // ex: "TVA 19%"
  isDefault Boolean @default(false)
  active    Boolean @default(true)

  products           Product[]
  categories         Category[]
  quoteItems         QuoteItem[]
  invoiceItems       InvoiceItem[]
  creditNoteItems    CreditNoteItem[]
  purchaseOrderItems PurchaseOrderItem[]
  onlineOrderItems   OnlineOrderItem[]

  @@index([rate])
  @@map("tax_rates")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  taxRateId   String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  taxRate   TaxRate?   @relation(fields: [taxRateId], references: [id])
  products  Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique // Référence interne (ex: EL-CAB-001)
  name          String
  slug          String   @unique
  description   String?
  brand         String?
  barcode       String?  @unique
  priceHT       Decimal  @db.Decimal(12, 3) // Prix unitaire HT
  costPrice     Decimal? @db.Decimal(12, 3) // Prix de revient (marge)
  unit          String   @default("unité")
  weightKg      Decimal? @db.Decimal(8, 3)
  categoryId    String?
  taxRateId     String
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  minStockAlert Decimal  @db.Decimal(14, 3) @default(0) // Seuil d'alerte stock
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category           Category?          @relation(fields: [categoryId], references: [id])
  taxRate            TaxRate            @relation(fields: [taxRateId], references: [id])
  images             ProductImage[]
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  quoteItems         QuoteItem[]
  invoiceItems       InvoiceItem[]
  creditNoteItems    CreditNoteItem[]
  purchaseOrderItems PurchaseOrderItem[]
  onlineOrderItems   OnlineOrderItem[]

  @@index([categoryId])
  @@index([taxRateId])
  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int    @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Stock : dépôts, niveaux, mouvements (traçabilité complète)
// ---------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  phone     String?
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  storeSettings  StoreSettings?

  @@map("warehouses")
}

model StockLevel {
  id               String   @id @default(cuid())
  productId        String
  warehouseId      String
  quantity         Decimal  @db.Decimal(14, 3) @default(0) // Quantité physique disponible
  reservedQuantity Decimal  @db.Decimal(14, 3) @default(0) // Réservée (commandes en ligne)
  updatedAt        DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id          String            @id @default(cuid())
  type        StockMovementType
  productId   String
  warehouseId String
  quantity    Decimal           @db.Decimal(14, 3) // Signé : + entrée / - sortie
  reason      String? // Motif (obligatoire pour ADJUSTMENT / INVENTORY)
  reference   String? // N° facture, n° commande, n° transfert...
  userId      String? // Responsable ; null = "système" (mouvement automatique)
  createdAt   DateTime          @default(now())

  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([type])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Fournisseurs & bons de commande
// ---------------------------------------------------------------------------

model Supplier {
  id              String   @id @default(cuid())
  name            String
  company         String?
  email           String?
  phone           String?
  address         String?
  city            String?
  matriculeFiscal String?
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([active])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String             @id @default(cuid())
  number       String             @unique // BON-YYYY-######
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String?
  createdById  String
  totalHT      Decimal            @db.Decimal(12, 3) @default(0)
  totalTVA     Decimal            @db.Decimal(12, 3) @default(0)
  totalTTC     Decimal            @db.Decimal(12, 3) @default(0)
  vatBreakdown Json               @default("{}")
  receivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantity         Decimal @db.Decimal(14, 3)
  unitPriceHT      Decimal @db.Decimal(12, 3)
  taxRateId        String
  receivedQuantity Decimal @db.Decimal(14, 3) @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  taxRate       TaxRate       @relation(fields: [taxRateId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

model Customer {
  id              String       @id @default(cuid())
  type            CustomerType @default(PARTICULIER)
  userId          String?      @unique // Compte boutique (User role CLIENT) associé
  firstName       String?
  lastName        String?
  companyName     String?
  matriculeFiscal String? // Obligatoire si PROFESSIONNEL
  cin             String? // Carte d'identité nationale (clients particuliers)
  email           String?
  phone           String?
  address         String?
  city            String?
  notes           String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user         User?          @relation(fields: [userId], references: [id])
  quotes       Quote[]
  invoices     Invoice[]
  creditNotes  CreditNote[]
  onlineOrders OnlineOrder[]

  @@index([type])
  @@index([active])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Devis
// ---------------------------------------------------------------------------

model Quote {
  id            String      @id @default(cuid())
  number        String      @unique // DEV-YYYY-######
  customerId    String
  createdById   String
  status        QuoteStatus @default(DRAFT)
  validUntil    DateTime?
  totalHT       Decimal     @db.Decimal(12, 3) @default(0)
  totalTVA      Decimal     @db.Decimal(12, 3) @default(0)
  totalTTC      Decimal     @db.Decimal(12, 3) @default(0)
  timbreFiscal  Decimal     @db.Decimal(12, 3) @default(0) // Toujours 0 sur un devis
  discountGlobal Decimal   @db.Decimal(12, 3) @default(0)
  vatBreakdown  Json        @default("{}")
  notes         String?
  conditions    String?
  invoiceId     String?    @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer   Customer     @relation(fields: [customerId], references: [id])
  createdBy  User         @relation("QuoteCreator", fields: [createdById], references: [id])
  items      QuoteItem[]
  invoice    Invoice?     @relation("QuoteToInvoice", fields: [invoiceId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id            String        @id @default(cuid())
  quoteId       String
  productId     String?
  sku           String // Référence (snapshot)
  designation   String // Désignation (snapshot)
  quantity      Decimal       @db.Decimal(14, 3)
  unitPriceHT   Decimal       @db.Decimal(12, 3)
  discountType  DiscountType?
  discountValue Decimal       @db.Decimal(12, 3) @default(0)
  netUnitPrice  Decimal       @db.Decimal(12, 3) // PU HT après remise ligne
  lineHT        Decimal       @db.Decimal(12, 3) // Prix HT ligne (net × qty)
  taxRateId     String
  lineTVA       Decimal       @db.Decimal(12, 3)
  lineTTC       Decimal       @db.Decimal(12, 3)

  quote    Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id])
  taxRate  TaxRate   @relation(fields: [taxRateId], references: [id])

  @@index([quoteId])
  @@map("quote_items")
}

// ---------------------------------------------------------------------------
// Factures
// ---------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique // FAC-YYYY-###### (verrouillée après validation)
  customerId    String
  quoteId       String?
  createdById   String
  source        InvoiceSource @default(MANUAL)
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  totalHT       Decimal       @db.Decimal(12, 3) @default(0)
  totalTVA      Decimal       @db.Decimal(12, 3) @default(0)
  totalTTC      Decimal       @db.Decimal(12, 3) @default(0)
  timbreFiscal  Decimal       @db.Decimal(12, 3) @default(1) // 1 DT sur chaque facture
  discountGlobal Decimal     @db.Decimal(12, 3) @default(0)
  paidAmount    Decimal       @db.Decimal(12, 3) @default(0)
  vatBreakdown  Json          @default("{}")
  notes         String?
  validatedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer    Customer      @relation(fields: [customerId], references: [id])
  quote       Quote?        @relation("QuoteToInvoice")
  createdBy   User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  creditNotes CreditNote[]

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id            String        @id @default(cuid())
  invoiceId     String
  productId     String?
  sku           String // Snapshot
  designation   String // Snapshot
  quantity      Decimal       @db.Decimal(14, 3)
  unitPriceHT   Decimal       @db.Decimal(12, 3)
  discountType  DiscountType?
  discountValue Decimal       @db.Decimal(12, 3) @default(0)
  netUnitPrice  Decimal       @db.Decimal(12, 3)
  lineHT        Decimal       @db.Decimal(12, 3)
  taxRateId     String
  lineTVA       Decimal       @db.Decimal(12, 3)
  lineTTC       Decimal       @db.Decimal(12, 3)

  invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id])
  taxRate  TaxRate   @relation(fields: [taxRateId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

// ---------------------------------------------------------------------------
// Avoirs (retours)
// ---------------------------------------------------------------------------

model CreditNote {
  id            String            @id @default(cuid())
  number        String            @unique // AV-YYYY-######
  invoiceId     String
  customerId    String
  createdById   String
  status        CreditNoteStatus  @default(DRAFT)
  reason        String
  totalHT       Decimal           @db.Decimal(12, 3) @default(0)
  totalTVA      Decimal           @db.Decimal(12, 3) @default(0)
  totalTTC      Decimal           @db.Decimal(12, 3) @default(0)
  timbreFiscal  Decimal           @db.Decimal(12, 3) @default(0) // L'avoir ne porte pas de timbre
  vatBreakdown  Json              @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  invoice   Invoice             @relation(fields: [invoiceId], references: [id])
  customer  Customer            @relation(fields: [customerId], references: [id])
  createdBy User                @relation("CreditNoteCreator", fields: [createdById], references: [id])
  items     CreditNoteItem[]

  @@index([invoiceId])
  @@map("credit_notes")
}

model CreditNoteItem {
  id            String        @id @default(cuid())
  creditNoteId  String
  productId     String?
  sku           String
  designation   String
  quantity      Decimal       @db.Decimal(14, 3)
  unitPriceHT   Decimal       @db.Decimal(12, 3)
  discountType  DiscountType?
  discountValue Decimal       @db.Decimal(12, 3) @default(0)
  netUnitPrice  Decimal       @db.Decimal(12, 3)
  lineHT        Decimal       @db.Decimal(12, 3)
  taxRateId     String
  lineTVA       Decimal       @db.Decimal(12, 3)
  lineTTC       Decimal       @db.Decimal(12, 3)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])
  taxRate    TaxRate    @relation(fields: [taxRateId], references: [id])

  @@index([creditNoteId])
  @@map("credit_note_items")
}

// ---------------------------------------------------------------------------
// Paiements
// ---------------------------------------------------------------------------

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String?
  amount      Decimal       @db.Decimal(12, 3)
  method      PaymentMethod
  reference   String?
  receivedAt  DateTime      @default(now())
  createdById String
  note        String?

  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([receivedAt])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Commandes en ligne (boutique)
// ---------------------------------------------------------------------------

model OnlineOrder {
  id              String               @id @default(cuid())
  number          String               @unique // OC-YYYY-######
  customerId      String
  status          OnlineOrderStatus    @default(PENDING)
  paymentMethod   OnlinePaymentMethod  @default(COD)
  paymentStatus   OnlinePaymentStatus  @default(PENDING)
  deliveryMethod  OnlineDeliveryMethod @default(DELIVERY)
  pickupTime      DateTime? // Heure de récupération demandée (retrait en magasin)
  shippingFullName String
  shippingAddress String
  shippingCity    String
  shippingPhone   String
  shippingNote    String?
  shippingCost    Decimal              @db.Decimal(12, 3) @default(0)
  subtotalHT      Decimal              @db.Decimal(12, 3) @default(0)
  totalHT         Decimal              @db.Decimal(12, 3) @default(0)
  totalTVA        Decimal              @db.Decimal(12, 3) @default(0)
  totalTTC        Decimal              @db.Decimal(12, 3) @default(0)
  timbreFiscal    Decimal              @db.Decimal(12, 3) @default(1)
  discountGlobal  Decimal              @db.Decimal(12, 3) @default(0)
  vatBreakdown    Json                 @default("{}")
  withInvoice     Boolean              @default(false) // Facture demandée → TVA incluse
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  customer Customer             @relation(fields: [customerId], references: [id])
  items    OnlineOrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("online_orders")
}

model OnlineOrderItem {
  id            String        @id @default(cuid())
  onlineOrderId String
  productId     String
  sku           String
  designation   String
  quantity      Decimal       @db.Decimal(14, 3)
  unitPriceHT   Decimal       @db.Decimal(12, 3)
  discountType  DiscountType?
  discountValue Decimal       @db.Decimal(12, 3) @default(0)
  netUnitPrice  Decimal       @db.Decimal(12, 3)
  lineHT        Decimal       @db.Decimal(12, 3)
  taxRateId     String
  lineTVA       Decimal       @db.Decimal(12, 3)
  lineTTC       Decimal       @db.Decimal(12, 3)

  onlineOrder OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  taxRate     TaxRate     @relation(fields: [taxRateId], references: [id])

  @@index([onlineOrderId])
  @@map("online_order_items")
}

// ---------------------------------------------------------------------------
// Notifications (centre de notifications back-office)
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String? // null = diffusion à tout le personnel
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Compteurs de numérotation séquentielle (atomique, par année)
// ---------------------------------------------------------------------------

model Sequence {
  id         String @id @default(cuid())
  prefix     String // FAC, DEV, AV, OC, BON, TRF
  year       Int
  lastNumber Int    @default(0)

  @@unique([prefix, year])
  @@map("sequences")
}

// ---------------------------------------------------------------------------
// Paramètres magasin (singleton, id = 1)
// ---------------------------------------------------------------------------

model StoreSettings {
  id                Int      @id @default(1)
  storeName         String   @default("Magasin Électrique")
  slogan            String?
  activity          String? // Activité (ex: vente de matériel électrique)
  address           String?
  city              String?
  phone             String?
  email             String?
  matriculeFiscal   String?
  rib               String? // RIB pour paiement par virement
  legalNotes        String? // Mentions légales bas de page PDF
  paymentTerms      String? // Conditions de règlement
  currency          String   @default("DT")
  logoUrl           String?
  invoiceFooterText String?
  defaultWarehouseId String?    @unique
  updatedAt         DateTime @updatedAt

  defaultWarehouse Warehouse? @relation(fields: [defaultWarehouseId], references: [id])

  @@map("store_settings")
}