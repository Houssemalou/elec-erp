{
  "name": "elec",
  "version": "1.0.0",
  "private": true,
  "description": "ERP + boutique en ligne pour magasin de produits électriques (Tunisie)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n erp,vitrine -c blue,green \"npm run dev -w apps/erp-admin\" \"npm run dev -w apps/vitrine\"",
    "dev:erp": "npm run dev -w apps/erp-admin",
    "dev:vitrine": "npm run dev -w apps/vitrine",
    "build": "npm run build -w apps/erp-admin && npm run build -w apps/vitrine",
    "build:erp": "npm run build -w apps/erp-admin",
    "build:vitrine": "npm run build -w apps/vitrine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:migrate:dev": "npm run db:migrate:dev -w packages/db",
    "db:seed": "npm run db:seed -w packages/db",
    "db:studio": "npm run db:studio -w packages/db",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}