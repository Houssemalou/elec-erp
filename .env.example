# ------------------------------------------------------------------
# Base de données PostgreSQL (partagée entre les 2 applications)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://elec:elec_password@localhost:5432/elec?schema=public"

# ------------------------------------------------------------------
# Auth.js — JWT (secret partagé entre erp-admin et vitrine pour
# partager la même session de cookie de domaine)
# ------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------
# URLs publiques des applications
# ------------------------------------------------------------------
ERP_URL="http://localhost:3001"
SHOP_URL="http://localhost:3000"
NEXT_PUBLIC_SHOP_URL="http://localhost:3000"
NEXT_PUBLIC_ERP_URL="http://localhost:3001"

# ------------------------------------------------------------------
# Seed / premier admin (voir packages/db/prisma/seed.ts)
# ------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@magasin.tn"
SEED_ADMIN_PASSWORD="Admin123!"